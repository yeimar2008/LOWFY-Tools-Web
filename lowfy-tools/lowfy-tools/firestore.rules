rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // FUNCIONES AUXILIARES
    // ========================================================================

    // Devuelve true si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Devuelve el UID del usuario autenticado
    function getUid() {
      return request.auth.uid;
    }

    // Devuelve true si el documento pertenece al usuario autenticado
    function isOwner(resourceDoc) {
      return isAuthenticated() && resourceDoc.data.ownerId == getUid();
    }

    // Devuelve true si el campo ownerId no se intenta cambiar en una actualización
    function ownerIdNotChanged(resourceDoc, newDoc) {
      return newDoc.data.ownerId == resourceDoc.data.ownerId;
    }

    // Valida que un campo sea string no vacío (opcional)
    function isOptionalString(value) {
      return value == null || value is string;
    }

    // Valida que un campo sea string requerido (no vacío)
    function isRequiredString(value) {
      return value is string && value.size() > 0;
    }

    // Valida que un valor monetario sea número >= 0
    function isValidMoney(value) {
      return value is number || value is int;
    }

    // Valida que un valor monetario sea >= 0
    function isNonNegative(value) {
      return value >= 0;
    }

    // Estados aceptados para cotizaciones
    function isValidQuoteStatus(value) {
      return value in ['borrador', 'enviada', 'aceptada', 'rechazada'];
    }

    // Estados aceptados para transacciones
    function isValidTxStatus(value) {
      return value in ['paid', 'pending'];
    }

    // Tipos aceptados para transacciones
    function isValidTxType(value) {
      return value in ['income', 'expense'];
    }

    // Fecha válida en formato YYYY-MM-DD (string)
    function isValidDateString(value) {
      return value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    // Campos permitidos para clientes
    function isValidClientMap(map) {
      return map.keys() == ['ownerId', 'name', 'phone', 'email', 'notes', 'createdAt', 'updatedAt', 'id'];
    }

    // Campos permitidos para cotizaciones
    function isValidQuoteMap(map) {
      return map.keys() == ['ownerId', 'number', 'clientId', 'date', 'validUntil', 'status', 'description', 'items', 'createdAt', 'updatedAt', 'id'];
    }

    // Campos permitidos para transacciones
    function isValidTxMap(map) {
      return map.keys() == ['ownerId', 'type', 'category', 'description', 'amount', 'date', 'status', 'paidAmount', 'clientId', 'createdAt', 'updatedAt', 'id'];
    }

    // Validar items de cotización (arreglo de objetos con desc, qty, price)
    function isValidItemsList(items) {
      return items is list &&
             !items.exists(i, !(i is map &&
               i.desc is string && i.desc.size() > 0 &&
               i.qty is number && i.qty > 0 &&
               i.price is number && i.price >= 0));
    }

    // Validar configuración (settings)
    function isValidSettingsMap(map) {
      return map.keys() == ['uid', 'categories', 'updatedAt'] &&
             map.categories is list &&
             !map.categories.exists(c, !(c is string && c.size() > 0));
    }

    // ========================================================================
    // COLECCIÓN users (perfil de autenticación)
    // ========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && userId == getUid();
      allow create: if isAuthenticated() && userId == getUid()
                    && request.data.uid == getUid()
                    && request.data.email is string;
      allow update: if isAuthenticated() && userId == getUid()
                    && request.data.uid == getUid();
      allow delete: if false; // no permitir borrar perfil de usuario desde el cliente

      // Validar campos de usuario
      allow create, update: if request.data.keys() == ['uid', 'email', 'displayName', 'createdAt', 'updatedAt'];
    }

    // ========================================================================
    // COLECCIÓN clients
    // ========================================================================
    match /clients/{docId} {
      // Lectura: solo el propietario
      allow read: if isOwner(resource);

      // Creación: solo el propietario, ownerId debe ser el UID autenticado
      allow create: if isAuthenticated()
                    && request.data.ownerId == getUid()
                    && request.data.id == docId
                    && isValidClientMap(request.data)
                    && isRequiredString(request.data.name)
                    && isOptionalString(request.data.phone)
                    && isOptionalString(request.data.email)
                    && isOptionalString(request.data.notes)
                    && request.data.createdAt is timestamp
                    && request.data.updatedAt is timestamp;

      // Actualización: solo el propietario, no se puede cambiar ownerId
      allow update: if isOwner(resource)
                    && ownerIdNotChanged(resource, request.data)
                    && isValidClientMap(request.data)
                    && isRequiredString(request.data.name)
                    && request.data.updatedAt is timestamp;

      // Eliminación: solo el propietario
      allow delete: if isOwner(resource);
    }

    // ========================================================================
    // COLECCIÓN quotes (cotizaciones con ítems embebidos)
    // ========================================================================
    match /quotes/{docId} {
      // Lectura: solo el propietario
      allow read: if isOwner(resource);

      // Creación: solo el propietario
      allow create: if isAuthenticated()
                    && request.data.ownerId == getUid()
                    && request.data.id == docId
                    && isValidQuoteMap(request.data)
                    && isRequiredString(request.data.number)
                    && isRequiredString(request.data.clientId)
                    && isValidDateString(request.data.date)
                    && (request.data.validUntil == null || isValidDateString(request.data.validUntil))
                    && isValidQuoteStatus(request.data.status)
                    && isOptionalString(request.data.description)
                    && isValidItemsList(request.data.items)
                    && request.data.createdAt is timestamp
                    && request.data.updatedAt is timestamp;

      // Actualización: solo el propietario, no se puede cambiar ownerId
      allow update: if isOwner(resource)
                    && ownerIdNotChanged(resource, request.data)
                    && isValidQuoteMap(request.data)
                    && isRequiredString(request.data.number)
                    && isRequiredString(request.data.clientId)
                    && isValidDateString(request.data.date)
                    && isValidQuoteStatus(request.data.status)
                    && isValidItemsList(request.data.items)
                    && request.data.updatedAt is timestamp;

      // Eliminación: solo el propietario
      allow delete: if isOwner(resource);
    }

    // ========================================================================
    // COLECCIÓN transactions (ingresos, gastos, pagos parciales)
    // ========================================================================
    match /transactions/{docId} {
      // Lectura: solo el propietario
      allow read: if isOwner(resource);

      // Creación: solo el propietario
      allow create: if isAuthenticated()
                    && request.data.ownerId == getUid()
                    && request.data.id == docId
                    && isValidTxMap(request.data)
                    && isValidTxType(request.data.type)
                    && isRequiredString(request.data.category)
                    && isRequiredString(request.data.description)
                    && isValidMoney(request.data.amount)
                    && isNonNegative(request.data.amount)
                    && isValidDateString(request.data.date)
                    && isValidTxStatus(request.data.status)
                    && isValidMoney(request.data.paidAmount)
                    && isNonNegative(request.data.paidAmount)
                    && (request.data.clientId == null || isRequiredString(request.data.clientId))
                    && request.data.createdAt is timestamp
                    && request.data.updatedAt is timestamp;

      // Actualización: solo el propietario, no se puede cambiar ownerId
      allow update: if isOwner(resource)
                    && ownerIdNotChanged(resource, request.data)
                    && isValidTxMap(request.data)
                    && isValidTxType(request.data.type)
                    && isRequiredString(request.data.category)
                    && isRequiredString(request.data.description)
                    && isValidMoney(request.data.amount)
                    && isNonNegative(request.data.amount)
                    && isValidDateString(request.data.date)
                    && isValidTxStatus(request.data.status)
                    && isValidMoney(request.data.paidAmount)
                    && isNonNegative(request.data.paidAmount)
                    && request.data.updatedAt is timestamp;

      // Eliminación: solo el propietario
      allow delete: if isOwner(resource);
    }

    // ========================================================================
    // COLECCIÓN settings (configuración por usuario, doc ID = uid)
    // ========================================================================
    match /settings/{docId} {
      allow read: if isAuthenticated() && docId == getUid();
      allow create: if isAuthenticated() && docId == getUid()
                    && request.data.uid == getUid()
                    && isValidSettingsMap(request.data);
      allow update: if isAuthenticated() && docId == getUid()
                    && request.data.uid == getUid()
                    && isValidSettingsMap(request.data);
      allow delete: if false; // no permitir borrar configuración desde el cliente
    }

    // ========================================================================
    // NEGAR CUALQUIER ACCESO A COLECCIONES NO DEFINIDAS
    // ========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
